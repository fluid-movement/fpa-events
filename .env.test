# Test environment — committed on purpose (see .gitignore: `!.env.test`).
#
# Loaded by `npm run dev:test` (Vite `--mode test`) and by playwright.config.ts.
# NEVER put real secrets in this file. Machine-specific overrides — different
# Postgres credentials, for instance — go in `.env.test.local`, which stays
# gitignored because it matches the `.env.*` rule.

# Dedicated test database. Create it once with:
#   createdb fpa_events_test && npm run db:reset:test
# Keeping this separate from the dev DB matters: the integration suite inserts
# and deletes rows directly via tests/integration/helpers/db.ts.
DATABASE_URL=postgres://postgres@localhost:5432/fpa_events_test

# Better Auth. The secret only signs test sessions, so a fixed value is fine.
# The URL must match the port `dev:test` serves on (5174, not the dev server's
# 5173) — better-auth validates the request origin against it, and
# tests/integration/session.test.ts asserts the auth endpoint answers on the
# serving origin.
BETTER_AUTH_SECRET=test-secret-not-used-in-production
BETTER_AUTH_URL=http://localhost:5173

# Rankings API — read-only, so the tests can safely hit the real service.
FPA_API_URL=https://fpa-api.fluid-movement.de

# --- Deliberately blank below this line ---------------------------------
# Each of these has a graceful fallback, and leaving them empty is what keeps
# the suite from touching real external services.

# Blank => src/lib/server/email.ts falls back to sendDev(), which logs the
# subject and first URL to the console. Essential: the auth specs sign up users
# at @playwright.local, and with a live key Mailgun would attempt real delivery
# to a domain that does not exist.
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_FROM_EMAIL=

# Blank => src/lib/server/turnstile.ts short-circuits verifyTurnstile() to true
# and the widget stays hidden. The existing specs already depend on this.
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Blank => src/lib/server/r2.ts builds its client lazily with `?? ''` fallbacks,
# so nothing throws at import; only an actual upload would fail. No integration
# test uploads today.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
