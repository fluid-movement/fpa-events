{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "fpa-event-app",
	"compatibility_date": "2022-11-07",
	"compatibility_flags": ["nodejs_compat"],
	"vars": {
		"BETTER_AUTH_URL": "https://your-app.pages.dev"
	}
	// Add these secrets via: wrangler secret put TURSO_DATABASE_URL
	// and: wrangler secret put TURSO_AUTH_TOKEN
	// and: wrangler secret put BETTER_AUTH_SECRET
}
