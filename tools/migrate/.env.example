# Legacy side — always required, no fallbacks.
# On the server: the old app's Postgres *internal* URL (from its Coolify page)
# and the old R2 bucket's credentials. The legacy side is only ever read.
LEGACY_DATABASE_URL=postgres://user:pass@localhost:5432/fpa_legacy
LEGACY_R2_ACCOUNT_ID=
LEGACY_R2_ACCESS_KEY_ID=
LEGACY_R2_SECRET_ACCESS_KEY=
LEGACY_R2_BUCKET_NAME=

# Target side — each TARGET_* variable falls back to the event app's own name
# (DATABASE_URL, R2_ACCOUNT_ID, R2_ACCESS_KEY_ID, R2_SECRET_ACCESS_KEY,
# R2_BUCKET_NAME, R2_PUBLIC_URL). Inside the deployed app container you
# therefore set NONE of these. Locally, set them here (or export the app names).
TARGET_DATABASE_URL=postgres://user:pass@localhost:5432/fpa_events
TARGET_R2_ACCOUNT_ID=
TARGET_R2_ACCESS_KEY_ID=
TARGET_R2_SECRET_ACCESS_KEY=
TARGET_R2_BUCKET_NAME=
# Public base URL of the target bucket, no trailing slash — must match the app's R2_PUBLIC_URL
TARGET_R2_PUBLIC_URL=
