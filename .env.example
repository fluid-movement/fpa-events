# PostgreSQL Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/fpa_events

# Better Auth Configuration
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:5173

# Mailgun (transactional emails)
# If unset, emails are logged to console in dev mode
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_FROM_EMAIL=

# Cloudflare R2 (image storage)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=https://your-bucket.r2.dev

# Cloudflare Turnstile (bot protection on public forms)
# If unset, captcha is disabled (widget hidden, verification skipped) — handy for dev.
# For local testing, Cloudflare publishes always-pass dummy keys:
#   site key:   1x00000000000000000000AA
#   secret key: 1x0000000000000000000000000000000AA
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Rankings API (fpa-api — read-only view over the freestyle judging/results data)
# If unset, the rankings page shows an "unavailable" notice instead of failing.
FPA_API_URL=https://fpa-api.fluid-movement.de
